# ULPF Phase 6 Production Runtime Container
FROM python:3.12-slim-bookworm

WORKDIR /app

# Security: Install minimal dependencies and create unprivileged user
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --create-home --shell /bin/bash --uid 10001 ulpfuser

COPY pyproject.toml requirements.resolved.lock /app/
COPY packages /app/packages
COPY apps /app/apps
COPY contracts /app/contracts
COPY schemas /app/schemas

RUN pip install --no-cache-dir -e .

# Create durable storage mount points with unprivileged ownership
RUN mkdir -p /app/data/raw /app/data/uce /app/data/export && \
    chown -R ulpfuser:ulpfuser /app

USER 10001:10001

ENV PYTHONUNBUFFERED=1 \
    ULPF_ENVIRONMENT=production-like \
    ULPF_RAW_BASE_DIR=/app/data/raw

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health/live')" || exit 1

CMD ["uvicorn", "ulpf_api.app:app", "--host", "0.0.0.0", "--port", "8000"]
