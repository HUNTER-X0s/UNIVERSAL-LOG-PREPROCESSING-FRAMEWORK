        "ulpf_normalization",
        "ulpf_parser_runtime",
        "ulpf_platform",
        "ulpf_semantic",
        "ulpf_mapping",
        "ulpf_onboarding",
        "ulpf_ai",
        "ulpf_runtime",
        "ulpf_streaming",
        "ulpf_storage",
        "ulpf_search",
        "ulpf_delivery",
        "ulpf_observability"
      ]
    },
    {
