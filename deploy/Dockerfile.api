FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY apps ./apps
COPY packages ./packages
COPY contracts ./contracts

RUN useradd --create-home --uid 10001 ulpf \
    && pip install --no-cache-dir . \
    && chown -R ulpf:ulpf /app

USER 10001
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8080/api/v1/health', timeout=3)"
CMD ["python", "-m", "uvicorn", "ulpf_api.app:app", "--host", "0.0.0.0", "--port", "8080", "--log-config", ""]
