{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulpf.local/schemas/mapping-approval.v1.schema.json",
  "title": "ULPF Mapping Approval Record v1",
  "type": "object",
  "required": [
    "schema_version",
    "approval_id",
    "mapping_id",
    "mapping_version",
    "reviewer",
    "decision",
    "timestamp",
    "mapping_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "approval_id": { "type": "string" },
    "mapping_id": { "type": "string" },
    "mapping_version": { "type": "string" },
    "reviewer": { "type": "string" },
    "decision": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED", "CHANGES_REQUESTED"]
    },
    "timestamp": { "type": "string" },
    "reviewer_comment": { "type": "string" },
    "mapping_sha256": { "type": "string" },
    "ai_assisted": { "type": "boolean", "default": false },
    "source_sample_reference": { "type": "string" },
    "replay_validation_status": {
      "type": "string",
      "enum": ["PASSED", "FAILED", "SKIPPED"]
    }
  },
  "additionalProperties": false
}
