{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulpf.local/schemas/drift-report.v1.schema.json",
  "title": "ULPF Schema Drift Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "profile_id",
    "drift_state",
    "timestamp"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "report_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "profile_version": { "type": "string" },
    "drift_state": {
      "type": "string",
      "enum": ["STABLE", "MINOR_DRIFT", "MAJOR_DRIFT", "BREAKING_DRIFT", "UNKNOWN"]
    },
    "timestamp": { "type": "string" },
    "fields_added": { "type": "array", "items": { "type": "string" } },
    "fields_removed": { "type": "array", "items": { "type": "string" } },
    "type_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "old_type", "new_type"],
        "properties": {
          "field": { "type": "string" },
          "old_type": { "type": "string" },
          "new_type": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "recommended_action": { "type": "string" }
  },
  "additionalProperties": false
}
