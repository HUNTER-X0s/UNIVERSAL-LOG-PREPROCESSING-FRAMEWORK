{
  "environment": "development",
  "service_name": "ulpf-api",
  "log_level": "INFO",
  "request_max_bytes": 1048576,
  "api_prefix": "/api/v1",
  "intake_max_event_bytes": 1048576,
  "intake_max_http_header_bytes": 16384,
  "intake_http_requests_per_minute": 600,
  "intake_tcp_enabled": false,
  "intake_tcp_host": "127.0.0.1",
  "intake_tcp_port": 5514,
  "intake_udp_enabled": false,
  "intake_udp_host": "127.0.0.1",
  "intake_udp_port": 5514,
  "intake_max_connections": 64,
  "intake_read_timeout_seconds": 5.0,
  "intake_evidence_directory": "data/evidence",
  "intake_evidence_max_events": 10000,
  "intake_evidence_max_bytes": 1073741824,
  "intake_development_retrieval_enabled": false,
  "api_documentation_enabled": true
}
