# Non-secret Phase 2 API configuration. Do not place credentials in this file.
ULPF_ENVIRONMENT=development
ULPF_SERVICE_NAME=ulpf-api
ULPF_LOG_LEVEL=INFO
ULPF_REQUEST_MAX_BYTES=1048576
ULPF_API_PREFIX=/api/v1
ULPF_INTAKE_MAX_EVENT_BYTES=1048576
ULPF_INTAKE_MAX_HTTP_HEADER_BYTES=16384
ULPF_INTAKE_HTTP_REQUESTS_PER_MINUTE=600
ULPF_INTAKE_TCP_ENABLED=false
ULPF_INTAKE_TCP_HOST=127.0.0.1
ULPF_INTAKE_TCP_PORT=5514
ULPF_INTAKE_UDP_ENABLED=false
ULPF_INTAKE_UDP_HOST=127.0.0.1
ULPF_INTAKE_UDP_PORT=5514
ULPF_INTAKE_MAX_CONNECTIONS=64
ULPF_INTAKE_READ_TIMEOUT_SECONDS=5.0
ULPF_INTAKE_EVIDENCE_DIRECTORY=data/evidence
ULPF_INTAKE_EVIDENCE_MAX_EVENTS=10000
ULPF_INTAKE_EVIDENCE_MAX_BYTES=1073741824
ULPF_INTAKE_DEVELOPMENT_RETRIEVAL_ENABLED=false

# Secret only. Inject outside source control when authentication is required.
# ULPF_INTAKE_AUTH_TOKEN=

ULPF_API_DOCUMENTATION_ENABLED=true

# Optional only when the contract directory is outside the repository layout.
# ULPF_CONTRACTS_DIR=/absolute/path/to/contracts/jsonschema
