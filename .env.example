# Non-secret Phase 1 API configuration. Do not place credentials in this file.
ULPF_ENVIRONMENT=development
ULPF_SERVICE_NAME=ulpf-api
ULPF_LOG_LEVEL=INFO
ULPF_REQUEST_MAX_BYTES=1048576
ULPF_API_PREFIX=/api/v1
ULPF_API_DOCUMENTATION_ENABLED=true

# Optional only when the contract directory is outside the repository layout.
# ULPF_CONTRACTS_DIR=/absolute/path/to/contracts/jsonschema
